build-windows/
Testing/
SimpleQtApp_autogen/

# ---- Generated sources --------------------------------------------------
# qrc_resources.cpp is produced by rcc from resources.qrc.
# resources/code/neovere.py is the configure_file() copy of neovere.py.
qrc_resources.cpp
resources.qrc.depends
resources/code/neovere.py

